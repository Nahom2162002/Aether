// M5: classes, fields, methods, self, init
class Point {
    fn init(x, y) {
        self.x = x;
        self.y = y;
    }

    fn len2() {
        return self.x * self.x + self.y * self.y;
    }

    fn move_by(dx, dy) {
        self.x = self.x + dx;
        self.y = self.y + dy;
    }
}

let p = Point(3, 4);
print(p.len2());       // 25
p.move_by(1, 1);
print(p.x);            // 4

let q = p;             // same object, not a copy
q.x = 100;
print(p.x);            // 100
